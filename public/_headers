/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

# Native approved illustrations keep their filenames and must revalidate.
/kairum/*
  Cache-Control: public, max-age=0, must-revalidate

# Preserve the published report library's indexing policy and revalidation.
/informes/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

# Explicit charset: these generated text files contain accented characters.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/en/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/pt-br/llms-full.txt
  Content-Type: text/plain; charset=utf-8

https://:project.pages.dev/*
  X-Robots-Tag: noindex
