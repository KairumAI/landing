---
import { toLocale } from "../i18n";
import { locales, localeMeta, type Locale } from "../i18n/locales";
import { equivalentPaths, type PageId } from "../lib/routes";
import { metadata } from "../lib/metadata";
import "../styles/kairum-tokens.css";
import "../styles/kairum-styles.css";
import "../styles/kairum-brand.css";
import "../styles/kairum-home.css";
import "../styles/kairum-cinematic.css";
interface Props {
  pageId?: PageId;
  locale?: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { pageId = "home", locale = toLocale(Astro.currentLocale) } = Astro.props;
const meta = metadata(pageId, locale, Astro.site!);
const {
  title = meta.title,
  description = meta.description,
  noindex = meta.noindex,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = equivalentPaths(pageId);
const ogImage = new URL(localeMeta[locale].ogImage, Astro.site).href;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf5" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(({ locale: code, path }) => (
          <link
            rel="alternate"
            hreflang={localeMeta[code].hreflang}
            href={new URL(path, Astro.site).href}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates[0].path, Astro.site).href}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KAIRUM" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {locales
      .filter((code) => code !== locale)
      .map((code) => (
        <meta
          property="og:locale:alternate"
          content={localeMeta[code].ogLocale}
        />
      ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="KAIRUM" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="KAIRUM" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/kairum/assets/inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {pageId === "home" && !noindex && (
      <link
        rel="preload"
        href="/kairum/assets/home-hero-stage.png"
        as="image"
        fetchpriority="high"
      />
    )}
    <slot name="head" />
  </head>
  <body data-page={pageId}>
    <slot />
  </body>
</html>
