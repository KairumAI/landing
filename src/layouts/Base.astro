---
import { getImage } from "astro:assets";
import atmosphere from "../assets/atmosphere-yellow.webp";
import interFont from "../assets/fonts/inter.woff2?url";
import { getDictionary, toLocale } from "../i18n";
import { localeMeta, locales } from "../i18n/locales";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/header.css";
import "../styles/hero.css";
import "../styles/context.css";
import "../styles/journey.css";
import "../styles/answers.css";
import "../styles/patterns.css";
import "../styles/sources.css";
import "../styles/audience.css";
import "../styles/report.css";
import "../styles/faq.css";
import "../styles/contact.css";
import "../styles/footer.css";
import "../styles/controls.css";
import "../styles/dialog.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const t = getDictionary(locale);
const {
  title = t.meta.title,
  description = t.meta.description,
  noindex = false,
} = Astro.props;
const background = await getImage({ src: atmosphere });
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(localeMeta[locale].ogImage, Astro.site).href;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf5" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    {!noindex &&
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={localeMeta[code].hreflang}
          href={new URL(localeMeta[code].path, Astro.site).href}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL("/", Astro.site).href}
      />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {locales
      .filter((code) => code !== locale)
      .map((code) => (
        <meta
          property="og:locale:alternate"
          content={localeMeta[code].ogLocale}
        />
      ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={interFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={background.src}
      as="image"
      type="image/webp"
      fetchpriority="high"
    />
    <slot name="head" />
  </head>
  <body style={`--atmosphere-image: url("${background.src}")`}>
    <slot />
  </body>
</html>
