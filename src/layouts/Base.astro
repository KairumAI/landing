---
import { getImage } from "astro:assets";
import mark from "../assets/convergencia-mark.webp";
import atmosphere from "../assets/atmosphere-yellow.webp";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/header.css";
import "../styles/hero.css";
import "../styles/context.css";
import "../styles/journey.css";
import "../styles/answers.css";
import "../styles/patterns.css";
import "../styles/sources.css";
import "../styles/report.css";
import "../styles/faq.css";
import "../styles/contact.css";
import "../styles/footer.css";
import "../styles/controls.css";
import "../styles/dialog.css";
import "../styles/responsive.css";
import "../styles/identity.css";
import "../styles/audience.css";
import "../styles/refinements.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "KAIRUM — Visibilidad de marca en IA",
  description = "Entendé cómo aparece tu marca en respuestas de IA. KAIRUM conecta consultas, fuentes y revisión humana en un informe para orientar las decisiones de tu equipo.",
  noindex = false,
} = Astro.props;
const favicon = await getImage({ src: mark });
const background = await getImage({ src: atmosphere });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf5" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && (
      <meta
        property="og:url"
        content={new URL(Astro.url.pathname, Astro.site).href}
      />
    )}
    <link rel="icon" type="image/webp" href={favicon.src} />
    <link
      rel="preload"
      href="/assets/inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body style={`--atmosphere-image: url("${background.src}")`}>
    <slot />
  </body>
</html>
