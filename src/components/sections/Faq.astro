---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
const { faq: t } = getDictionary(Astro.currentLocale);
---

<section
  id="preguntas"
  class="faq-section wrap section-pad"
  aria-labelledby="faq-title"
>
  <div class="feature-copy reveal">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="faq-title">
      {t.title[0]}
      <br />
      {t.title[1]}
    </h2>
  </div>
  <div class="faq-list">
    {t.items.map(({ question, answer }) => (
      <details>
        <summary>
          {question}
          <Icon name="Plus" />
        </summary>
        <div class="faq-answer">
          <p>{answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
