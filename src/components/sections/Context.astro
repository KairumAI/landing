---
import { getDictionary } from "../../i18n";
const { context: t } = getDictionary(Astro.currentLocale);
---

<section class="context-section wrap" aria-labelledby="context-title">
  <div class="context-grid">
    <h2 id="context-title" class="reveal">
      {t.title[0]}
      <br />
      {t.title[1]}
    </h2>
    <p class="reveal">{t.intro}</p>
  </div>
  <div class="question-ribbon" role="group" aria-label={t.questionsLabel}>
    <span>{t.questions[0]}</span>
    <span>{t.questions[1]}</span>
    <span>{t.questions[2]}</span>
    <span>{t.questions[3]}</span>
  </div>
</section>
