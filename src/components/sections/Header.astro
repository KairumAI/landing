---
import Icon from "../Icon.astro";
import { Image } from "astro:assets";
import lockup from "../../assets/convergencia-lockup.webp";
---

<header class="site-header">
  <div class="nav wrap">
    <a href="#inicio" class="brand brand-lockup" aria-label="KAIRUM, inicio">
      <Image src={lockup} alt="" width={1536} height={1024} loading="eager" />
    </a>
    <nav class="desktop-nav" aria-label="Principal">
      <a href="#recorrido">Cómo funciona</a>
      <a href="#equipos">Para quién</a>
      <a href="#informe">El informe</a>
    </nav>
    <a
      class="button primary nav-cta"
      data-book
      href="https://calendly.com/brunodecruz/30min"
      target="_blank"
      rel="noopener noreferrer"
    >
      Book a call <Icon name="ArrowUpRight" />
    </a>
    <button
      class="motion-toggle"
      id="motion-toggle"
      aria-label="Pausar todas las animaciones"
      aria-pressed="false"
    >
      <Icon name="Pause" />
      <span>Pausar movimiento</span>
    </button>
    <button
      class="icon-button menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icon name="List" />
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Menú móvil" hidden>
    <a href="#recorrido">Cómo funciona</a>
    <a href="#equipos">Para quién</a>
    <a href="#informe">El informe</a>
    <a href="#preguntas">Preguntas frecuentes</a>
  </nav>
</header>
