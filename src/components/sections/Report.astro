---
import Icon from "../Icon.astro";
import { Image } from "astro:assets";
import lockup from "../../assets/convergencia-lockup.webp";
import ReportModule from "../ReportModule.astro";
import { getDictionary } from "../../i18n";
const { report: t, client, meta } = getDictionary(Astro.currentLocale);
const { modules } = client;
---

<section id="informe" class="report-section section-pad">
  <div class="wrap split">
    <div class="feature-copy reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>
        {t.title[0]}
        <br />
        {t.title[1]}
        <br />
        {t.title[2]}
      </h2>
      <p>{t.intro}</p>
      <div class="report-options" role="group" aria-label={t.optionsLabel}>
        <button data-module="menciones" aria-pressed="true">
          <Icon name="Check" />
          {t.options.menciones}
        </button>
        <button data-module="fuentes" aria-pressed="true">
          <Icon name="Check" />
          {t.options.fuentes}
        </button>
        <button data-module="prioridades" aria-pressed="true">
          <Icon name="Check" />
          {t.options.prioridades}
        </button>
      </div>
      <button class="text-link" id="read-report">
        {t.openLabel} <Icon name="ArrowUpRight" />
      </button>
      <p class="deliverable-note">{t.note}</p>
    </div>
    <div class="report-stage">
      <div class="paper-back back-two" aria-hidden="true"></div>
      <div class="paper-back back-one" aria-hidden="true"></div>
      <article class="report-paper">
        <div class="report-brand">
          <div class="brand brand-lockup" role="img" aria-label={meta.siteName}>
            <Image src={lockup} alt="" loading="eager" />
          </div>
          <span>{t.exampleLabel}</span>
        </div>
        <h3>
          {t.paperTitle[0]}
          <br />
          {t.paperTitle[1]}
        </h3>
        <p class="paper-subtitle">{t.paperSubtitle}</p>
        <div id="report-modules">
          {(Object.keys(modules) as (keyof typeof modules)[]).map(
            (moduleKey) => (
              <ReportModule moduleKey={moduleKey} />
            ),
          )}
        </div>
        <div class="paper-foot">{t.paperFoot}</div>
      </article>
    </div>
  </div>
</section>
