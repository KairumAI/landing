---
import { Image } from "astro:assets";
import lockup from "../../assets/convergencia-lockup.webp";
import { getDictionary, toLocale } from "../../i18n";
import { localeMeta, locales } from "../../i18n/locales";
const { footer: t, header } = getDictionary(Astro.currentLocale);
const locale = toLocale(Astro.currentLocale);
---

<footer class="site-footer wrap">
  <a href="#inicio" class="brand brand-lockup" aria-label={t.brandLabel}>
    <Image src={lockup} alt="" loading="lazy" />
  </a>
  <p>{t.motto}</p>
  <div>
    <a href="#recorrido">{header.how}</a>
    <a href="#preguntas">{header.faq}</a>
  </div>
  <nav class="language-switch" aria-label={t.languageLabel}>
    {locales.map((code) => (
      <a
        href={localeMeta[code].path}
        hreflang={localeMeta[code].hreflang}
        lang={localeMeta[code].htmlLang}
        aria-current={code === locale ? "page" : undefined}
      >
        {localeMeta[code].name}
      </a>
    ))}
  </nav>
</footer>
