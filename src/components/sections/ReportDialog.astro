---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
const { reportDialog: t } = getDictionary(Astro.currentLocale);
---

<dialog id="report-dialog" aria-labelledby="report-dialog-title">
  <div class="dialog-toolbar">
    <span id="report-dialog-title">{t.title}</span>
    <button class="icon-button" data-close-dialog aria-label={t.closeLabel}>
      <Icon name="X" />
    </button>
  </div>
  <div class="dialog-content">
    <h2>{t.heading}</h2>
    <p>{t.intro}</p>
    <div class="report-context">
      <span class="eyebrow">{t.questionLabel}</span>
      <h3>{t.question}</h3>
      <p>{t.caseLabel}</p>
    </div>
    <div id="expanded-report"></div>
    <details class="report-evidence">
      <summary>
        {t.evidenceSummary} <Icon name="Plus" />
      </summary>
      <div class="report-evidence-grid">
        <div>
          <span class="eyebrow">{t.answerLabel}</span>
          <blockquote>{t.answer}</blockquote>
        </div>
        <div>
          <span class="eyebrow">{t.sourceLabel}</span>
          <p>{t.source}</p>
        </div>
      </div>
      <p class="report-review">
        <Icon name="Eye" />
        {t.review}
      </p>
    </details>
  </div>
</dialog>
