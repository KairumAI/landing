---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
import { highlightBrand } from "../../i18n/locales";
const { answers: t, client } = getDictionary(Astro.currentLocale);
const [beforeBrand, afterBrand] =
  client.providerExamples[0].answer.split(highlightBrand);
---

<section id="plataforma" class="answer-section wrap section-pad">
  <div class="split">
    <div class="feature-copy reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>
        {t.title[0]}
        <br />
        {t.title[1]}
        <br />
        {t.title[2]}
      </h2>
      <p>{t.intro}</p>
      <div class="provider-switch" role="group" aria-label={t.selectLabel}>
        <button data-provider="0" aria-pressed="true">
          <img src="/assets/openai.svg" alt="" />
          {t.providerButtons[0]}
        </button>
        <button data-provider="1" aria-pressed="false">
          <img src="/assets/gemini.svg" alt="" />
          {t.providerButtons[1]}
        </button>
        <button data-provider="2" aria-pressed="false">
          <img src="/assets/claude.svg" alt="" />
          {t.providerButtons[2]}
        </button>
      </div>
      <span class="small-muted">{t.apiNote}</span>
    </div>
    <div class="answer-stack" aria-live="polite" data-selected-provider="0">
      <div class="stack-ghost ghost-back" aria-hidden="true"></div>
      <div class="stack-ghost ghost-mid" aria-hidden="true"></div>
      <article class="answer-card">
        <div class="response-heading">
          <img id="stack-logo" src="/assets/openai.svg" alt="" />
          <span id="stack-provider">{client.providerExamples[0].name}</span>
          <span>{t.exampleLabel}</span>
        </div>
        <div class="stack-question">{client.heroQuery}</div>
        <blockquote id="stack-answer">
          {beforeBrand}
          <mark>{highlightBrand}</mark>
          {afterBrand}
        </blockquote>
        <div class="reading-note">
          <Icon name="Eye" />
          <div>
            <span>{t.changeLabel}</span>
            <p id="stack-insight">{client.providerExamples[0].insight}</p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
