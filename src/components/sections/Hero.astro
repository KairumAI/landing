---
import Icon from "../Icon.astro";
import { heroQueryText } from "../../data/hero";
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow hero-category">VISIBILIDAD DE MARCA EN IA</span>
      <h1 id="hero-title">
        Una pregunta.
        <br />
        Todo un mapa de <span>oportunidades.</span>
      </h1>
      <p>
        Entendé cómo la IA describe tu marca, qué fuentes cita y qué información
        conviene revisar. KAIRUM conecta las respuestas con decisiones para tu
        equipo.
      </p>
      <div class="actions">
        <a
          class="button primary"
          data-book
          href="https://calendly.com/brunodecruz/30min"
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call <Icon name="ArrowUpRight" />
        </a>
        <a class="text-link" href="#recorrido">
          Mirá cómo funciona <Icon name="ArrowDown" />
        </a>
      </div>
      <div class="hero-proof">
        <span>
          <Icon name="Eye" /> Mirá las respuestas
        </span>
        <span>
          <Icon name="Link" /> Seguí las fuentes
        </span>
        <span>
          <Icon name="CursorClick" /> Decidí qué sigue
        </span>
      </div>
    </div>
    <div
      class="hero-visual"
      aria-label="Demostración animada de una consulta y sus respuestas"
    >
      <div class="floating-provider provider-a">
        <img src="/assets/openai.svg" alt="" />
        OpenAI API
      </div>
      <div class="floating-provider provider-b">
        <img src="/assets/gemini.svg" alt="" />
        Gemini API
      </div>
      <div class="floating-provider provider-c">
        <img src="/assets/claude.svg" alt="" />
        Claude API
      </div>
      <div class="hero-console">
        <div class="console-top">
          <span>
            <Icon name="Sparkle" /> Una consulta, más contexto.
          </span>
          <span id="hero-status" class="live-status">
            Preparando consulta
          </span>
        </div>
        <div class="query-bar">
          <Icon name="MagnifyingGlass" />
          <span id="hero-query" aria-hidden="true"></span>
          <span class="sr-only">{heroQueryText}</span>
          <span class="typing-caret" aria-hidden="true"></span>
        </div>
        <div class="hero-response">
          <div class="response-heading">
            <img src="/assets/gemini.svg" alt="" />
            Gemini API
            <span>Ejemplo ilustrativo</span>
          </div>
          <p id="hero-answer" aria-hidden="true"></p>
          <span class="sr-only">
            Ejemplo ficticio: Norte aparece por su control de stock, pero sus
            integraciones quedan por verificar.
          </span>
          <div class="answer-lines" aria-hidden="true">
            <b></b>
            <b></b>
            <b></b>
          </div>
        </div>
        <div class="hero-sources">
          <span>Fuentes de esta respuesta</span>
          <div>
            <span>
              <Icon name="Globe" /> norte.example
            </span>
            <span>
              <Icon name="FileText" /> sector.example
            </span>
          </div>
        </div>
        <div class="hero-result">
          <span class="check-disc">
            <Icon name="Check" />
          </span>
          <div>
            <strong>Aparece por su control de stock.</strong>
            <span>Las integraciones quedan por verificar.</span>
          </div>
          <Icon name="ArrowUpRight" />
        </div>
      </div>
      <div class="hero-report">
        <Icon name="FileText" />
        <div>
          <span>Tu próximo paso</span>
          <strong>Aclarar las integraciones en la web</strong>
        </div>
        <Icon name="CheckCircle" />
      </div>
      <div class="demo-controls">
        <span>Norte · Marca ficticia del ejemplo</span>
        <button id="hero-pause" aria-label="Pausar demostración">
          <Icon name="Pause" />
          <span>Pausar</span>
        </button>
        <button id="hero-replay" aria-label="Repetir demostración">
          <Icon name="ArrowClockwise" />
          <span>Repetir</span>
        </button>
      </div>
    </div>
  </div>
</section>
