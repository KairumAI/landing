---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
import { bookingUrl } from "../../i18n/locales";
const { hero: t, book, client } = getDictionary(Astro.currentLocale);
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow hero-category">{t.eyebrow}</span>
      <h1 id="hero-title">
        {t.titleFirst}
        <br />
        {t.titleSecond}
        <span>{t.titleHighlight}</span>
      </h1>
      <p>{t.intro}</p>
      <div class="actions">
        <a
          class="button primary"
          data-book
          href={bookingUrl}
          aria-describedby="new-tab-hint"
          target="_blank"
          rel="noopener noreferrer"
        >
          {book.label} <Icon name="ArrowUpRight" />
        </a>
        <a class="text-link" href="#recorrido">
          {t.how} <Icon name="ArrowDown" />
        </a>
      </div>
      <div class="hero-proof">
        <span>
          <Icon name="Eye" /> {t.proof[0]}
        </span>
        <span>
          <Icon name="Link" /> {t.proof[1]}
        </span>
        <span>
          <Icon name="CursorClick" /> {t.proof[2]}
        </span>
      </div>
    </div>
    <div class="hero-visual" role="group" aria-label={t.visualLabel}>
      <div class="floating-provider provider-a">
        <img src="/assets/openai.svg" alt="" />
        {t.providerNames[0]}
      </div>
      <div class="floating-provider provider-b">
        <img src="/assets/gemini.svg" alt="" />
        {t.providerNames[1]}
      </div>
      <div class="floating-provider provider-c">
        <img src="/assets/claude.svg" alt="" />
        {t.providerNames[2]}
      </div>
      <div class="hero-console">
        <div class="console-top">
          <span>
            <Icon name="Sparkle" /> {t.console}
          </span>
          <span id="hero-status" class="live-status">
            {t.initialStatus}
          </span>
        </div>
        <div class="query-bar">
          <Icon name="MagnifyingGlass" />
          <span id="hero-query" aria-hidden="true"></span>
          <span class="sr-only">{client.heroQuery}</span>
          <span class="typing-caret" aria-hidden="true"></span>
        </div>
        <div class="hero-response">
          <div class="response-heading">
            <img src="/assets/gemini.svg" alt="" />
            {t.providerNames[1]}
            <span>{t.exampleLabel}</span>
          </div>
          <p id="hero-answer" aria-hidden="true"></p>
          <span class="sr-only">{t.screenReaderAnswer}</span>
          <div class="answer-lines" aria-hidden="true">
            <b></b>
            <b></b>
            <b></b>
          </div>
        </div>
        <div class="hero-sources">
          <span>{t.sourcesLabel}</span>
          <div>
            <span>
              <Icon name="Globe" /> {t.sourceDomains[0]}
            </span>
            <span>
              <Icon name="FileText" /> {t.sourceDomains[1]}
            </span>
          </div>
        </div>
        <div class="hero-result">
          <span class="check-disc">
            <Icon name="Check" />
          </span>
          <div>
            <strong>{t.resultTitle}</strong>
            <span>{t.resultDetail}</span>
          </div>
          <Icon name="ArrowUpRight" />
        </div>
      </div>
      <div class="hero-report">
        <Icon name="FileText" />
        <div>
          <span>{t.nextStepLabel}</span>
          <strong>{t.nextStep}</strong>
        </div>
        <Icon name="CheckCircle" />
      </div>
      <div class="demo-controls">
        <span>{t.demoNote}</span>
        <button
          id="hero-pause"
          aria-label={client.motion.demoPauseLabel}
          data-state="playing"
        >
          <Icon name="Pause" />
          <Icon name="Play" />
          <span>{client.motion.demoPause}</span>
        </button>
        <button id="hero-replay" aria-label={t.replayLabel}>
          <Icon name="ArrowClockwise" />
          <span>{t.replay}</span>
        </button>
      </div>
    </div>
  </div>
</section>
