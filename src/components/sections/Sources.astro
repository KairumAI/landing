---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
const { sources: t, client } = getDictionary(Astro.currentLocale);
const { sources } = client;
---

<section id="fuentes" class="sources-section wrap section-pad">
  <div class="split source-layout">
    <div class="source-workspace reveal" data-selected-source="0">
      <div class="source-top">
        <Icon name="Link" /> {t.followLabel}
        <span>{t.exampleLabel}</span>
      </div>
      <div class="source-quote">
        “<span id="source-prefix">{sources[0].prefix}</span>{" "}
        <mark id="source-highlight">{sources[0].highlight}</mark>.”
      </div>
      <div class="source-tabs" role="group" aria-label={t.selectLabel}>
        <button data-source="0" aria-pressed="true">
          <Icon name="Globe" /> {t.tabs[0]}
        </button>
        <button data-source="1" aria-pressed="false">
          <Icon name="FileText" /> {t.tabs[1]}
        </button>
      </div>
      <article class="source-document">
        <div class="source-url" id="source-url">
          {sources[0].url}
        </div>
        <h3 id="source-title">{sources[0].title}</h3>
        <p id="source-excerpt">
          {sources[0].excerpt[0]}
          <mark>{sources[0].excerpt[1]}</mark>
          {sources[0].excerpt[2]}
        </p>
        <div class="human-note">
          <span class="reviewer-avatar">
            <Icon name="NotePencil" />
          </span>
          <div>
            <strong>{t.reviewTitle}</strong>
            <p id="source-review">{sources[0].review}</p>
          </div>
        </div>
      </article>
    </div>
    <div class="feature-copy reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>
        {t.title[0]}
        <br />
        {t.title[1]}
        <br />
        {t.title[2]}
      </h2>
      <p>{t.intro}</p>
      <ul class="clean-list">
        <li>
          <Icon name="Check" /> {t.benefits[0]}
        </li>
        <li>
          <Icon name="Check" /> {t.benefits[1]}
        </li>
        <li>
          <Icon name="Check" /> {t.benefits[2]}
        </li>
      </ul>
    </div>
  </div>
</section>
