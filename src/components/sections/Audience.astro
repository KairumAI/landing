---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
const { audience: t, client } = getDictionary(Astro.currentLocale);
const { audienceReadings } = client;
---

<section
  id="equipos"
  class="audience-section wrap section-pad"
  aria-labelledby="audience-title"
>
  <div class="section-heading">
    <div class="reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="audience-title">
        {t.title[0]}
        <br />
        {t.title[1]}
      </h2>
    </div>
    <p class="reveal">
      {t.intro[0]}
      <br />
      {t.intro[1]}
    </p>
  </div>
  <div class="audience-layout reveal">
    <div class="audience-controls" role="group" aria-label={t.controlsLabel}>
      <button
        data-audience="marca"
        aria-pressed="true"
        aria-controls="audience-panel"
      >
        <span class="audience-number">01</span>
        <span>
          <strong>{t.buttons.marca.title}</strong>
          <small>{t.buttons.marca.detail}</small>
        </span>
        <Icon name="ArrowUpRight" />
      </button>
      <button
        data-audience="contenido"
        aria-pressed="false"
        aria-controls="audience-panel"
      >
        <span class="audience-number">02</span>
        <span>
          <strong>{t.buttons.contenido.title}</strong>
          <small>{t.buttons.contenido.detail}</small>
        </span>
        <Icon name="ArrowUpRight" />
      </button>
      <button
        data-audience="agencias"
        aria-pressed="false"
        aria-controls="audience-panel"
      >
        <span class="audience-number">03</span>
        <span>
          <strong>{t.buttons.agencias.title}</strong>
          <small>{t.buttons.agencias.detail}</small>
        </span>
        <Icon name="ArrowUpRight" />
      </button>
    </div>
    <div
      class="audience-panel"
      id="audience-panel"
      aria-live="polite"
      aria-atomic="true"
      data-selected-audience="marca"
    >
      <div class="audience-panel-top">
        <Icon name="Quotes" />
        <span id="audience-lens">{audienceReadings.marca.lens}</span>
      </div>
      <div class="audience-panel-copy">
        <h3 id="audience-question">{audienceReadings.marca.question}</h3>
        <p id="audience-reading">{audienceReadings.marca.reading}</p>
        <div class="audience-outcome">
          <Icon name="ArrowRight" />
          <div>
            <span>{t.teamLabel}</span>
            <strong id="audience-action">
              {audienceReadings.marca.action}
            </strong>
          </div>
        </div>
      </div>
      <a class="text-link" href="#informe">
        {t.reportLink} <Icon name="ArrowDown" />
      </a>
    </div>
  </div>
</section>
