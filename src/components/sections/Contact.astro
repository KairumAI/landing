---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
import { bookingUrl } from "../../i18n/locales";
const { contact: t, book } = getDictionary(Astro.currentLocale);
---

<section id="contacto" class="contact-section">
  <div class="contact-light" aria-hidden="true"></div>
  <div class="wrap contact-inner">
    <span>{t.eyebrow}</span>
    <h2>
      {t.title[0]}
      <br />
      <em>{t.title[1]}</em>
    </h2>
    <p class="contact-intro">
      {t.intro[0]}
      <br /> {t.intro[1]}
    </p>
    <a
      class="button gold"
      data-book
      href={bookingUrl}
      aria-describedby="new-tab-hint"
      target="_blank"
      rel="noopener noreferrer"
    >
      {book.label} <Icon name="ArrowUpRight" />
    </a>
    <ol class="call-agenda" aria-label={t.agendaLabel}>
      <li>
        <span>01</span>
        <div>
          <h3>{t.agenda[0].title}</h3>
          <p>{t.agenda[0].detail}</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>{t.agenda[1].title}</h3>
          <p>{t.agenda[1].detail}</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>{t.agenda[2].title}</h3>
          <p>{t.agenda[2].detail}</p>
        </div>
      </li>
    </ol>
  </div>
</section>
