---
import Icon from "../Icon.astro";
import { Image } from "astro:assets";
import lockup from "../../assets/convergencia-lockup.webp";
import mark from "../../assets/convergencia-mark.webp";
import { getDictionary } from "../../i18n";
import { highlightBrand } from "../../i18n/locales";
const { journey: t, hero, client, meta } = getDictionary(Astro.currentLocale);
const { stageCaptions } = client;
const [firstBefore, firstAfter] = t.exampleAnswers[0].split(highlightBrand);
const [secondBefore, secondAfter] = t.exampleAnswers[1].split(highlightBrand);
const [thirdBefore, thirdAfter] = t.exampleAnswers[2].split(highlightBrand);
---

<section id="recorrido" class="journey" aria-labelledby="journey-title">
  <div class="journey-sticky">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{t.eyebrow}</span>
          <h2 id="journey-title">
            {t.title[0]}
            <br />
            {t.title[1]}
          </h2>
        </div>
        <p>
          {t.intro[0]}
          <br />
          {t.intro[1]}
        </p>
      </div>
      <div class="journey-shell">
        <div class="journey-nav" role="group" aria-label={t.navLabel}>
          <button data-stage="0" aria-pressed="true">
            <span>01</span>
            {t.steps[0]}
          </button>
          <button data-stage="1" aria-pressed="false">
            <span>02</span>
            {t.steps[1]}
          </button>
          <button data-stage="2" aria-pressed="false">
            <span>03</span>
            {t.steps[2]}
          </button>
          <button data-stage="3" aria-pressed="false">
            <span>04</span>
            {t.steps[3]}
          </button>
          <button data-stage="4" aria-pressed="false">
            <span>05</span>
            {t.steps[4]}
          </button>
        </div>
        <div class="journey-progress" aria-hidden="true">
          <span></span>
        </div>
        <div class="journey-canvas" data-stage-active="0">
          <div class="scene scene-question" data-scene="0">
            <span class="scene-kicker">{t.caseLabel}</span>
            <div class="large-question">
              <Icon name="MagnifyingGlass" />
              <span>
                {t.question[0]}
                <br />
                {t.question[1]}
              </span>
              <span class="send-disc">
                <Icon name="ArrowUpRight" />
              </span>
            </div>
            <div class="query-options">
              <span>{t.options[0]}</span>
              <span>{t.options[1]}</span>
              <span>{t.options[2]}</span>
            </div>
            <p class="scene-note">{t.questionNote}</p>
          </div>
          <div class="scene scene-network" data-scene="1" hidden>
            <svg class="network-connections" aria-hidden="true"></svg>
            <div class="network-query network-node" data-node="query">
              <Icon name="MagnifyingGlass" />
              <span>
                {t.networkQuery[0]}
                <br />
                <strong>{t.networkQuery[1]}</strong>
              </span>
            </div>
            <div class="network-hub network-node" data-node="hub">
              <Image
                src={mark}
                alt={meta.siteName}
                loading="eager"
                width={192}
                height={192}
              />
            </div>
            <div class="network-models">
              <div class="network-provider network-node" data-node="openai">
                <img src="/assets/openai.svg" alt="" />
                <div>
                  {hero.providerNames[0]}
                  <small>{t.networkNotes[0]}</small>
                </div>
                <Icon name="Check" />
              </div>
              <div class="network-provider network-node" data-node="gemini">
                <img src="/assets/gemini.svg" alt="" />
                <div>
                  {hero.providerNames[1]}
                  <small>{t.networkNotes[1]}</small>
                </div>
                <Icon name="Check" />
              </div>
              <div class="network-provider network-node" data-node="claude">
                <img src="/assets/claude.svg" alt="" />
                <div>
                  {hero.providerNames[2]}
                  <small>{t.networkNotes[2]}</small>
                </div>
                <Icon name="Check" />
              </div>
            </div>
            <p class="scene-note">{t.networkNote}</p>
          </div>
          <div class="scene scene-answers" data-scene="2" hidden>
            <div class="mini-answer">
              <div>
                <img src="/assets/openai.svg" alt="" />
                {hero.providerNames[0]}
              </div>
              <p>
                {firstBefore}
                <mark>{highlightBrand}</mark>
                {firstAfter}
              </p>
              <span>
                <Icon name="Link" /> {t.answerSources[0]}
              </span>
            </div>
            <div class="mini-answer featured">
              <div>
                <img src="/assets/gemini.svg" alt="" />
                {hero.providerNames[1]}
              </div>
              <p>
                {secondBefore}
                <mark>{highlightBrand}</mark>
                {secondAfter}
              </p>
              <span>
                <Icon name="Link" /> {t.answerSources[1]}
              </span>
            </div>
            <div class="mini-answer">
              <div>
                <img src="/assets/claude.svg" alt="" />
                {hero.providerNames[2]}
              </div>
              <p>
                {thirdBefore}
                <mark>{highlightBrand}</mark>
                {thirdAfter}
              </p>
              <span>
                <Icon name="Link" /> {t.answerSources[2]}
              </span>
            </div>
            <p class="scene-note">{t.answersNote}</p>
          </div>
          <div class="scene scene-evidence" data-scene="3" hidden>
            <article class="evidence-response">
              <span class="doc-kicker">{t.responseLabel}</span>
              <p>
                {t.evidenceAnswer[0]}
                <mark>{highlightBrand}</mark>
                {t.evidenceAnswer[1]}
              </p>
              <span class="source-badge">
                <Icon name="Link" /> {t.evidenceSource}
              </span>
            </article>
            <div class="evidence-bridge">
              <Icon name="ArrowRight" />
            </div>
            <article class="evidence-document">
              <div class="doc-browser">
                <Icon name="Globe" /> {t.answerSources[0]}
              </div>
              <h3>{t.evidenceTitle}</h3>
              <p>
                {t.evidenceExcerpt[0]}
                <mark>{t.evidenceExcerpt[1]}</mark>
                {t.evidenceExcerpt[2]}
              </p>
              <div class="review-chip">
                <Icon name="Eye" /> {t.reviewChip}
              </div>
            </article>
            <p class="scene-note">{t.evidenceNote}</p>
          </div>
          <div class="scene scene-report" data-scene="4" hidden>
            <div class="report-orbit">
              <span>
                <Icon name="Quotes" /> {t.reportOrbit[0]}
              </span>
              <span>
                <Icon name="Link" /> {t.reportOrbit[1]}
              </span>
              <span>
                <Icon name="CursorClick" /> {t.reportOrbit[2]}
              </span>
            </div>
            <article class="journey-report">
              <div class="report-brand">
                <div
                  class="brand brand-lockup"
                  role="img"
                  aria-label={meta.siteName}
                >
                  <Image src={lockup} alt="" loading="eager" />
                </div>
                <span>{t.exampleLabel}</span>
              </div>
              <h3>
                {t.reportTitle[0]}
                <br />
                {t.reportTitle[1]}
              </h3>
              <div class="report-rule"></div>
              <div class="report-summary">
                <span>{t.foundLabel}</span>
                <p>{t.found}</p>
                <span>{t.reviewLabel}</span>
                <p>{t.review}</p>
              </div>
            </article>
            <p class="scene-note">{t.reportNote}</p>
          </div>
        </div>
        <div class="journey-bottom">
          <span id="journey-caption" aria-live="polite">
            {stageCaptions[0]}
          </span>
          <span class="scroll-hint">
            <Icon name="ArrowDown" /> {t.scrollHint}
          </span>
          <span>{t.fictionalCase}</span>
        </div>
      </div>
    </div>
  </div>
</section>
