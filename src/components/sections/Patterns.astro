---
import Icon from "../Icon.astro";
import { getDictionary } from "../../i18n";
import type { PatternState } from "../../i18n/types";
const { patterns: t, client, hero } = getDictionary(Astro.currentLocale);
const { patterns, stateLabels } = client;
const stateIcons: Record<PatternState, string> = {
  mencion: "Check",
  comparacion: "Stack",
  ausente: "Minus",
};
---

<section
  class="patterns-section section-pad"
  aria-labelledby="patterns-title"
  data-intent="explorar"
>
  <div class="wrap">
    <div class="section-heading">
      <div class="reveal">
        <span class="eyebrow">{t.eyebrow}</span>
        <h2 id="patterns-title">
          {t.title[0]}
          <br />
          {t.title[1]}
        </h2>
      </div>
      <p class="reveal">
        {t.intro[0]}
        <br />
        {t.intro[1]}
      </p>
    </div>
    <div class="pattern-controls" role="group" aria-label={t.controlsLabel}>
      <button data-intent="explorar" aria-pressed="true">
        01 · {t.intents[0]}
      </button>
      <button data-intent="comparar" aria-pressed="false">
        02 · {t.intents[1]}
      </button>
      <button data-intent="elegir" aria-pressed="false">
        03 · {t.intents[2]}
      </button>
      <span>{t.exampleLabel}</span>
    </div>
    <div class="patterns-body">
      <div class="pattern-reading">
        <span>{t.focusLabel}</span>
        <h3 id="pattern-question">{patterns.explorar.question}</h3>
        <p id="pattern-insight">{patterns.explorar.insight}</p>
        <div class="pattern-legend">
          <span>
            <b class="dot mention"></b>
            {stateLabels.mencion}
          </span>
          <span>
            <b class="dot gold"></b>
            {stateLabels.comparacion}
          </span>
          <span>
            <b class="dot neutral"></b>
            {stateLabels.ausente}
          </span>
        </div>
      </div>
      <div
        class="matrix-scroll"
        role="region"
        tabindex="0"
        aria-label={t.matrixLabel}
      >
        <table class="pattern-matrix">
          <thead>
            <tr>
              <th>{t.conversationLabel}</th>
              <th>
                <img src="/assets/openai.svg" alt="" />
                {hero.providerNames[0]}
              </th>
              <th>
                <img src="/assets/gemini.svg" alt="" />
                {hero.providerNames[1]}
              </th>
              <th>
                <img src="/assets/claude.svg" alt="" />
                {hero.providerNames[2]}
              </th>
            </tr>
          </thead>
          {Object.entries(patterns).map(([intent, pattern]) => (
            <tbody data-intent-rows={intent} hidden={intent !== "explorar"}>
              {pattern.rows.map(([question, ...states]) => (
                <tr>
                  <td>{question}</td>
                  {states.map((state) => (
                    <td>
                      <span class={`matrix-state ${state}`}>
                        <Icon name={stateIcons[state]} />
                        {stateLabels[state]}
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </div>
</section>
