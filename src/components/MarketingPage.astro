---
import Base from "../layouts/Base.astro";
import { pageContent, equivalentPaths, type PageId } from "../lib/routes";
import { metadata } from "../lib/metadata";
import { toLocale } from "../i18n";
import { localeMeta, type Locale } from "../i18n/locales";
import { translator } from "../i18n/marketing";
import { seo } from "../i18n/marketing/seo";
interface Props {
  pageId?: PageId;
  locale?: Locale;
}
const { pageId = "home", locale = toLocale(Astro.currentLocale) } = Astro.props;
const { html } = pageContent(pageId, locale);
const meta = metadata(pageId, locale, Astro.site!);
const t = translator(locale);
const clientCopy = {
  menuOpen: t("abrir_menu"),
  menuClose: seo[locale].menuClose,
};
const serialize = (value: unknown) =>
  JSON.stringify(value).replaceAll("<", "\\u003c");
---

<Base pageId={pageId} locale={locale}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={serialize(meta.structuredData)}
  />
  <Fragment set:html={html} />
  <div class="locale-strip">
    <nav class="wrap" aria-label={seo[locale].language}>
      {equivalentPaths(pageId).map(({ locale: code, path }) => (
        <a
          href={path}
          lang={localeMeta[code].htmlLang}
          hreflang={localeMeta[code].hreflang}
          data-language-link
          aria-current={locale === code ? "page" : undefined}
        >
          {localeMeta[code].name}
        </a>
      ))}
    </nav>
  </div>
  <script
    is:inline
    type="application/json"
    id="i18n-client"
    set:html={serialize(clientCopy)}
  />
  <script>
    import "../scripts/cinematic/app.ts";
    document
      .querySelectorAll<HTMLAnchorElement>("[data-language-link]")
      .forEach((link) =>
        link.addEventListener("click", () => {
          if (location.hash) link.hash = location.hash;
        }),
      );
  </script>
</Base>
<style>
  .locale-strip {
    background: var(--kairum-white);
    border-top: 1px solid var(--kairum-line);
  }
  .locale-strip nav {
    display: flex;
    gap: 24px;
    align-items: center;
    min-height: 64px;
    flex-wrap: wrap;
    padding-block: 12px;
  }
  .locale-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    text-decoration: none;
    color: var(--kairum-muted);
  }
  .locale-strip a[aria-current="page"] {
    color: var(--kairum-ink);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
