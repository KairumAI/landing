---
import Base from "../layouts/Base.astro";
import { pageContent, equivalentPaths, type PageId } from "../lib/routes";
import { metadata } from "../lib/metadata";
import { toLocale } from "../i18n";
import { localeMeta, type Locale } from "../i18n/locales";
import { translator } from "../i18n/marketing";
import { seo } from "../i18n/marketing/seo";
import { contactConfig } from "../lib/contact-config";
import { createContactSlots } from "./kairum/contact-form";
import { escapeHtml } from "../lib/escape";
import "../styles/kairum-contact.css";
interface Props {
  pageId?: PageId;
  locale?: Locale;
}
const { pageId = "home", locale = toLocale(Astro.currentLocale) } = Astro.props;
const config = contactConfig(
  import.meta.env.PUBLIC_FORMSPARK_FORM_ID,
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
);
const { html: contentHtml } = pageContent(
  pageId,
  locale,
  createContactSlots(locale, config),
);
const languageNav = `<nav class="footer-languages" aria-label="${escapeHtml(seo[locale].language)}">${equivalentPaths(
  pageId,
)
  .map(
    ({ locale: code, path }) =>
      `<a href="${escapeHtml(path)}" lang="${localeMeta[code].htmlLang}" hreflang="${localeMeta[code].hreflang}" data-language-link${locale === code ? ' aria-current="page"' : ""}>${escapeHtml(localeMeta[code].name)}</a>`,
  )
  .join("")}</nav>`;
// Add the same selector to the shared footer of marketing and editorial pages.
const footerEnd = "</div></div></footer>";
if (contentHtml.split(footerEnd).length !== 2)
  throw new Error(`Missing unique footer language anchor: ${pageId}`);
const html = contentHtml.replace(footerEnd, `${languageNav}${footerEnd}`);
const meta = metadata(pageId, locale, Astro.site!);
const t = translator(locale);
const clientCopy = {
  menuOpen: t("abrir_menu"),
  menuClose: seo[locale].menuClose,
};
const serialize = (value: unknown) =>
  JSON.stringify(value).replaceAll("<", "\\u003c");
---

<Base pageId={pageId} locale={locale}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={serialize(meta.structuredData)}
  />
  <Fragment set:html={html} />
  <script
    is:inline
    type="application/json"
    id="i18n-client"
    set:html={serialize(clientCopy)}
  />
  <script>
    import "../scripts/contact-form";
    import "../scripts/cinematic/app.ts";
    document
      .querySelectorAll<HTMLAnchorElement>("[data-language-link]")
      .forEach((link) =>
        link.addEventListener("click", () => {
          if (location.hash) link.hash = location.hash;
        }),
      );
  </script>
</Base>
