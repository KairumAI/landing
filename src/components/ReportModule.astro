---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { ReportModuleKey } from "../i18n/types";

interface Props {
  moduleKey: ReportModuleKey;
}

const { moduleKey } = Astro.props;
const reportModule = getDictionary(Astro.currentLocale).client.modules[
  moduleKey
];
---

<section class="report-module" data-report-module={moduleKey}>
  <Icon name={reportModule.icon} />
  <div>
    <h4>{reportModule.title}</h4>
    <p>{reportModule.copy}</p>
  </div>
</section>
