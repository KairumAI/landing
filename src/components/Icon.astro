---
import type { SvgComponent } from "astro/types";

interface Props {
  name: string;
}

const { name } = Astro.props;
const icons = import.meta.glob<{ default: SvgComponent }>(
  "../assets/icons/*.svg",
  {
    eager: true,
  },
);
const Svg = icons[`../assets/icons/${name}.svg`]?.default;
if (!Svg) throw new Error(`Unknown icon: ${name}`);
---

<i data-icon={name} aria-hidden="true">
  <Svg width="100%" height="100%" aria-hidden="true" />
</i>
