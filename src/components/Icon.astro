---
import { icons, iconViewBox } from "./icons";

interface Props {
  name: string;
}

const { name } = Astro.props;
if (!(name in icons)) throw new Error(`Unknown icon: ${name}`);
---

<i data-icon={name} aria-hidden="true">
  <svg viewBox={iconViewBox} fill="currentColor">
    <use href={`#icon-${name}`} />
  </svg>
</i>
