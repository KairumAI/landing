{
  "name": "kairum-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "bun scripts/verify-public-delivery.ts public && astro build && bun scripts/verify-public-delivery.ts dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "check:reference": "bun scripts/verify-approved-reference.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:delivery": "playwright test --config playwright.delivery.config.ts",
    "check:delivery:live": "bun scripts/check-public-delivery-live.ts",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "chart.js": "4.5.1",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "0.186.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "6.0.3"
  }
}
